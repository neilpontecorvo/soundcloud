<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#3A3120" />
            <stroke android:width="4dp" android:color="#FFD166" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#2F2F2F" />
            <stroke android:width="4dp" android:color="#FFD166" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#14363A" />
            <stroke android:width="2dp" android:color="#5CE1E6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#1E1E1E" />
            <stroke android:width="1dp" android:color="#3A3A3A" />
        </shape>
    </item>
</selector>
