<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused + Selected: bright accent border -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1A1A1A" />
            <stroke android:width="4dp" android:color="#FF6600" />
        </shape>
    </item>
    <!-- Focused only: strong yellow glow border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1A1A1A" />
            <stroke android:width="4dp" android:color="#FFE066" />
        </shape>
    </item>
    <!-- Selected only: subtle accent -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#151515" />
            <stroke android:width="2dp" android:color="#FF6600" />
        </shape>
    </item>
    <!-- Default: dark card -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#121212" />
            <stroke android:width="1dp" android:color="#2A2A2A" />
        </shape>
    </item>
</selector>
