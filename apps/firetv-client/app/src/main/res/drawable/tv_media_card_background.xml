<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused + Selected: bright accent border -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#181818" />
            <stroke android:width="4dp" android:color="#FF5500" />
        </shape>
    </item>
    <!-- Focused only: strong yellow glow border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#181818" />
            <stroke android:width="4dp" android:color="#FF5500" />
        </shape>
    </item>
    <!-- Selected only: subtle accent -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#151515" />
            <stroke android:width="2dp" android:color="#FF5500" />
        </shape>
    </item>
    <!-- Default: dark card -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#101010" />
            <stroke android:width="1dp" android:color="#252525" />
        </shape>
    </item>
</selector>
