# Copy these values into ../.env.firetv.local, then fill in the two secrets.
# The launcher reads .env.firetv.local automatically.

PROVIDER_CLIENT_ID=replace-with-soundcloud-client-id
PROVIDER_CLIENT_SECRET=replace-with-soundcloud-client-secret

# The launcher can derive these defaults, but keeping them here makes the
# callback/token locations explicit and repeatable.
FIRETV_DEVICE_HOST=192.168.1.168
PORT=4000
HOST=0.0.0.0
ENABLE_DEBUG_AUTH=false

# Set FIRETV_BACKEND_HOST only if automatic LAN IP detection is wrong.
# FIRETV_BACKEND_HOST=192.168.1.167

# OAuth callback URL used by SoundCloud. This must match the backend URL the
# Fire TV and your browser can reach on the local network.
PROVIDER_AUTH_PUBLIC_BASE_URL=http://192.168.1.167:4000
PROVIDER_REDIRECT_URI=http://192.168.1.167:4000/v1/auth/callback
PROVIDER_ARTIST_URL=https://soundcloud.com/anelopontecorvo

# Stable server-side stores. The Fire TV stores only a session id; provider
# access/refresh tokens are written here after browser authorization completes.
SESSION_STORE_PATH=/Users/neilpontecorvo/soundcloud/services/api/data/sessions.json
PROVIDER_TOKEN_STORE_PATH=/Users/neilpontecorvo/soundcloud/services/api/.local/provider-token-store.json
